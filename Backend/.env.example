PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/restaurant_db
JWT_SECRET=your_super_secret_jwt_key_restaurant_2026

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer Configuration (e.g., Gmail App Password or SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Zaykora Royal Restaurant <orders@zaykora.com>"

# Stripe Checkout
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
FRONTEND_URL=http://localhost:8081
# Configure a Stripe webhook for POST /api/payment/webhook and the checkout.session.completed event.

# Native Google sign-in: server OAuth client ID (Web application type)
# GOOGLE_WEB_CLIENT_ID=YOUR_SERVER_CLIENT_ID.apps.googleusercontent.com

# Security: configure exact HTTPS browser origins for production; native clients have no Origin.
CORS_ALLOWED_ORIGINS=
# Set only to match the number of trusted reverse proxies (0, 1 or 2).
TRUST_PROXY_HOPS=0

# Account-security encryption: generate 32 random bytes as 64 hex characters; keep stable and back up securely.
SECURITY_DATA_KEY=

# Use true to require admin enrollment before protected admin actions. Enroll first via Account security.
REQUIRE_ADMIN_MFA=false
PUBLIC_API_URL=
# Independent 32-byte hex key for encrypted backup files; store outside exported database.
BACKUP_ENCRYPTION_KEY=
